[Unit]
Description=Hailo NPU firmware prime (re-handshake driver at boot if broken)
After=network.target suspend.target hibernation.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/hailo-prime-check.sh
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target